{
  "id": "/Segundo-Cerebro/",
  "name": "Segundo Cérebro",
  "short_name": "2°Cérebro",
  "description": "Seu sistema de organização pessoal gamificado",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#0a0a0a",
  "theme_color": "#FF6B00",
  "orientation": "any",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/icon-mono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Agenda de hoje",
      "short_name": "Agenda",
      "description": "Tarefas e eventos do dia",
      "url": "./index.html?tab=tarefas",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Skill Tree",
      "short_name": "Skills",
      "description": "Sua árvore de habilidades",
      "url": "./index.html?tab=skilltree",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calorias",
      "short_name": "Calorias",
      "description": "Registrar refeição",
      "url": "./index.html?tab=calorias",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Anotações",
      "short_name": "Notas",
      "description": "Capturar uma ideia",
      "url": "./index.html?tab=anotacoes",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "st_title",
      "text": "st_text",
      "url": "st_url"
    }
  },
  "widgets": [
    {
      "name": "Hoje",
      "short_name": "Hoje",
      "description": "Tarefas e hábitos pendentes de hoje",
      "tag": "sc-hoje",
      "template": "sc-hoje",
      "ms_ac_template": "./widgets/hoje-template.json",
      "data": "./widgets/hoje-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "screenshots": [
        { "src": "./icons/icon-512.png", "sizes": "512x512", "label": "Widget Hoje" }
      ]
    }
  ]
}
