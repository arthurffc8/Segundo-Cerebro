{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "🌳", "size": "Large", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Árvores de talento", "weight": "Bolder", "size": "Medium", "spacing": "None", "wrap": true },
            { "type": "TextBlock", "text": "${arvores.resumo}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${arvores.barra}  ${arvores.pctNivel}%", "color": "Warning", "spacing": "Small" },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${arvores.arvores}",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${emoji} ${nome}", "weight": "Bolder", "size": "Small", "wrap": false },
                { "type": "TextBlock", "text": "${barra}", "size": "Small", "color": "Accent", "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${nivel}/${max} · ${pct}%", "size": "Small", "isSubtle": true }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "Nenhuma árvore criada ainda.",
          "size": "Small",
          "isSubtle": true,
          "wrap": true,
          "$when": "${count(arvores.arvores) == 0}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Abrir Skill Tree",
      "verb": "abrir-skilltree"
    }
  ]
}
