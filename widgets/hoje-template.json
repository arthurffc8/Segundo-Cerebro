{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "👑", "size": "Large", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Segundo Cérebro", "weight": "Bolder", "size": "Medium", "spacing": "None", "wrap": true },
            { "type": "TextBlock", "text": "${resumo}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "AGENDA DE HOJE",
          "size": "Small",
          "weight": "Bolder",
          "isSubtle": true
        },
        {
          "type": "Container",
          "$data": "${itens}",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    { "type": "TextBlock", "text": "${hora}", "size": "Small", "weight": "Bolder", "color": "Accent", "spacing": "None" }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    { "type": "TextBlock", "text": "${titulo}", "size": "Small", "wrap": true, "spacing": "None" }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${vazio}",
          "size": "Small",
          "isSubtle": true,
          "wrap": true,
          "$when": "${vazio != ''}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Abrir agenda",
      "verb": "abrir-agenda"
    }
  ]
}
