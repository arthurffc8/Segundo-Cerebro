<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tarefa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✅  TAREFAS DE HOJE"
            android:textColor="#F0F0F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tarefa_atrasadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FF5A5A"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tarefa_resumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_carregando"
        android:textColor="#FF6B00"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/tarefa_progress"
        style="@style/WidgetProgress"
        android:layout_marginTop="6dp" />

    <TextView android:id="@+id/tarefa_row_0" style="@style/WidgetPendingRow" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/tarefa_row_1" style="@style/WidgetPendingRow" />
    <TextView android:id="@+id/tarefa_row_2" style="@style/WidgetPendingRow" />
    <TextView android:id="@+id/tarefa_row_3" style="@style/WidgetPendingRow" />
    <TextView android:id="@+id/tarefa_row_4" style="@style/WidgetPendingRow" />

    <TextView
        android:id="@+id/tarefa_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:text="@string/widget_carregando"
        android:textColor="#9A9A9A"
        android:textSize="11sp" />
</LinearLayout>
