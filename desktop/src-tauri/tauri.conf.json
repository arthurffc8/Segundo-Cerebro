{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Segundo Cérebro",
  "version": "1.0.0",
  "identifier": "com.arthurffc.segundocerebro",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Segundo Cérebro",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Seu sistema de organização pessoal gamificado",
    "longDescription": "Segundo Cérebro — tarefas, hábitos, metas, finanças e skill tree num app só, com lembretes que continuam rodando na bandeja."
  },
  "plugins": {}
}
